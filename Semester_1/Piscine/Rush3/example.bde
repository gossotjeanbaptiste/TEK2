; ================================
; - BISTROMATIC ADVANCED EXAMPLE -
; ================================

; Section 1: Basic Arithmetic
; Result: 33 + 42 = 75
push int32 33
push int32 42
add
display

; Section 2: Multiplication
; Result: 75 * 2 = 150
push int32 2
mul
display

; Section 3: Subtraction
; Result: 150 - 50 = 100
push int32 50
sub
display

; Section 4: Division
; Result: 100 / 4 = 25
push int32 4
div
display

; Section 5: Stack Operations - SWAP
; Push two values and swap them
push int32 100
push int32 200
swap
display ; Should be 100
display ; Should be 200

; Section 6: Register Operations
; Store values in registers 0 and 1
push int32 256
store 0
push int32 512
store 1

; Load and use registers
load 0  ; Push 256
load 1  ; Push 512
add
display ; 256 + 512 = 768

; Section 7: Independent Expression 1
; 10 + 5 = 15
push int32 10
push int32 5
add
display

; Section 8: Independent Expression 2
; 20 * 3 = 60
push int32 20
push int32 3
mul
display

; Section 9: Float Arithmetic
; 3.5 + 2.5 = 6.0
push float32 3.5
push float32 2.5
add
display

; Section 10: Float Multiplication
; 6.0 * 2.5 = 15.0
push float32 2.5
mul
display

; Section 11: Mixed Integer and Float
; 100 + 50.5 = 150.5 (int32 + float32)
push int32 100
push float32 50.5
add
display

; Section 12: Register operations with arithmetic
; Using registers 2-5
push int32 10
store 2
push int32 20
store 3
push int32 30
store 4
push int32 40
store 5

; Load and multiply
load 2  ; 10
load 3  ; 20
mul
display ; 10 * 20 = 200

; Load and add
load 4  ; 30
load 5  ; 40
add
display ; 30 + 40 = 70

; Section 13: Large Numbers
; Test with int64
push int64 1000000
push int64 2000000
add
display ; 3000000

; Section 14: Using More Registers (6-15)
; Store values
push int32 111
store 6
push int32 222
store 7
push int32 333
store 8
push int32 444
store 9
push int32 555
store 10
push int32 666
store 11
push int32 777
store 12
push int32 888
store 13
push int32 999
store 14
push int32 1111
store 15

; Load and display
load 6
display ; 111
load 7
display ; 222
load 8
display ; 333
load 9
display ; 444
load 10
display ; 555

; Section 15: Complex independent chain
; (5 + 3) * 10 = 80
push int32 5
push int32 3
add
push int32 10
mul
display

; Another chain
; 100 / 5 = 20
push int32 100
push int32 5
div
display

; Section 16: Stack Manipulation - CLEAR and final
; Push some values
push int32 100
push int32 200
push int32 300
clear
; Stack is now empty

; Final assertion
push int32 42
assert int32 42
exit