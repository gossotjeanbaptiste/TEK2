    "quiz": [
      {
        "question": "Qu'est-ce qu'un achat impulsif ?",
        "reponse": "C'est quand tu achètes quelque chose sans réfléchir, juste parce que tu le vois et que tu le veux tout de suite."
      },
      {
        "question": "Comment éviter de tout dépenser d'un coup ?",
        "reponse": "Fais une liste de ce dont tu as vraiment besoin, attends un jour avant d'acheter, et fixe-toi des limites de dépense."
      },
      {
        "question": "C'est quoi la différence entre un besoin et une envie ?",
        "reponse": "Un besoin c'est quelque chose d'essentiel (nourriture, vêtements). Une envie c'est quelque chose qu'on aimerait avoir mais qu'on peut vivre sans."
      },
      {
        "question": "Que faire avant d'acheter quelque chose de cher ?",
        "reponse": "Attendre quelques jours pour être sûr de le vouloir vraiment, comparer les prix, et vérifier si tu as assez d'argent."
      }
    ]
