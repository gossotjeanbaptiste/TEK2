    "quiz": [
      {
        "question": "Qu'est-ce qu'un porte-monnaie numérique ?",
        "reponse": "C'est une application ou un compte en ligne où tu gardes ton argent pour acheter des choses sur Internet."
      },
      {
        "question": "Pourquoi ai-je besoin de mes parents pour un porte-monnaie numérique ?",
        "reponse": "Parce qu'en étant mineur, tu dois avoir l'autorisation et la supervision d'un adulte pour gérer de l'argent en ligne."
      },
      {
        "question": "Est-ce que je peux acheter tout ce que je veux avec un porte-monnaie numérique ?",
        "reponse": "Non, certains achats sont réservés aux adultes. De plus, il faut toujours vérifier avec tes parents avant d'acheter."
      },
      {
        "question": "Comment protéger mon porte-monnaie numérique ?",
        "reponse": "Utilise un mot de passe fort, ne le partage avec personne (sauf tes parents), et ne clique pas sur des liens suspects."
      }
    ]
